.hero {
  padding: 32rpx 32rpx 80rpx;
  background: linear-gradient(135deg, #3A6BFF 0%, #6E8CFF 100%);
  box-sizing: border-box;
}

.hero-title {
  display: flex;
  flex-direction: column;
}

.h1 {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.h2 {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 8rpx;
}

.search {
  display: flex;
  flex-direction: row;
  align-items: center;
  background: #FFFFFF;
  border-radius: 40rpx;
  height: 76rpx;
  padding: 0 24rpx;
  margin-top: 28rpx;
  box-sizing: border-box;
}

.s-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.s-input {
  flex: 1;
  font-size: 26rpx;
  height: 76rpx;
}

.s-ph {
  color: #B3B8C8;
  font-size: 26rpx;
}

.s-clear {
  font-size: 26rpx;
  color: #B3B8C8;
  padding: 0 8rpx;
}

.stats {
  display: flex;
  flex-direction: row;
  background: #FFFFFF;
  border-radius: 24rpx;
  margin: -56rpx 24rpx 20rpx;
  padding: 24rpx 0;
  box-sizing: border-box;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #FF6B4A;
}

.c-green { color: #12B981; }
.c-blue { color: #3A6BFF; }
.c-orange { color: #FF9F43; }

.stat-label {
  font-size: 22rpx;
  color: #8A8FA3;
  margin-top: 4rpx;
}

.banner {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, #FFF6E9 0%, #FFECE8 100%);
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  margin: 0 24rpx 20rpx;
  box-sizing: border-box;
}

.banner-l {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.banner-t {
  font-size: 28rpx;
  font-weight: 600;
  color: #D4552F;
}

.banner-d {
  font-size: 22rpx;
  color: #B37A5E;
  margin-top: 6rpx;
}

.banner-btn {
  font-size: 24rpx;
  color: #FFFFFF;
  background: #FF6B4A;
  border-radius: 999rpx;
  padding: 10rpx 22rpx;
  margin-left: 16rpx;
}

.cats {
  margin-bottom: 16rpx;
  white-space: nowrap;
}

.cats-inner {
  display: flex;
  flex-direction: row;
  padding: 0 24rpx;
}

.cat {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  color: #6B7185;
  font-size: 24rpx;
  margin-right: 16rpx;
}

.cat-on {
  background: #3A6BFF;
  color: #FFFFFF;
}

.tabs {
  display: flex;
  flex-direction: row;
  background: #FFFFFF;
  margin: 0 24rpx 20rpx;
  border-radius: 20rpx;
  padding: 8rpx;
  box-sizing: border-box;
}

.tab {
  flex: 1;
  height: 68rpx;
  line-height: 68rpx;
  text-align: center;
  font-size: 26rpx;
  color: #6B7185;
  border-radius: 16rpx;
}

.tab-on {
  background: #EAF0FF;
  color: #3A6BFF;
  font-weight: 600;
}

.more {
  padding: 20rpx 0 40rpx;
  text-align: center;
}

.empty-btn {
  margin-top: 28rpx;
  padding: 16rpx 48rpx;
  border-radius: 999rpx;
  background: #3A6BFF;
  color: #FFFFFF;
  font-size: 26rpx;
}
