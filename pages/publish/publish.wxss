.type-wrap {
  display: flex;
  flex-direction: row;
  padding: 24rpx;
}

.type {
  flex: 1;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx 20rpx;
  margin-right: 20rpx;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  border: 2rpx solid transparent;
}

.type:last-child {
  margin-right: 0;
}

.type-on {
  border: 2rpx solid #3A6BFF;
  background: #F5F8FF;
}

.type-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1D26;
}

.type-on .type-name {
  color: #3A6BFF;
}

.type-hint {
  font-size: 22rpx;
  color: #8A8FA3;
  margin-top: 8rpx;
}

.field {
  margin-bottom: 28rpx;
}

.field:last-child {
  margin-bottom: 0;
}

.label {
  font-size: 26rpx;
  color: #6B7185;
  margin-bottom: 14rpx;
  display: block;
}

.req {
  color: #FF4D4F;
}

.tip {
  color: #B3B8C8;
  font-size: 22rpx;
}

.input {
  height: 84rpx;
  background: #F7F8FC;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.ph {
  color: #B3B8C8;
  font-size: 26rpx;
}

.mt {
  margin-top: 16rpx;
}

.flex1 {
  flex: 1;
}

.picker {
  height: 84rpx;
  background: #F7F8FC;
  border-radius: 16rpx;
  padding: 0 24rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
  box-sizing: border-box;
}

.arrow {
  color: #B3B8C8;
  font-size: 24rpx;
}

.feat-input {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.add-btn {
  margin-left: 16rpx;
  padding: 0 32rpx;
  height: 84rpx;
  line-height: 84rpx;
  background: #EAF0FF;
  color: #3A6BFF;
  border-radius: 16rpx;
  font-size: 26rpx;
}

.chips {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.chip {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: #EAF0FF;
  color: #3A6BFF;
  font-size: 24rpx;
  margin: 0 16rpx 16rpx 0;
}

.chip-gray {
  background: #F7F8FC;
  color: #8A8FA3;
}

.textarea {
  width: 100%;
  height: 200rpx;
  background: #F7F8FC;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.counter {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: #B3B8C8;
  margin-top: 8rpx;
}

.imgs {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.img-box {
  width: 200rpx;
  height: 200rpx;
  margin: 0 16rpx 16rpx 0;
  position: relative;
}

.img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
}

.img-del {
  position: absolute;
  top: 0;
  right: 0;
  width: 44rpx;
  height: 44rpx;
  border-radius: 0 16rpx 0 16rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #FFFFFF;
  font-size: 22rpx;
  text-align: center;
  line-height: 44rpx;
}

.img-add {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  background: #F7F8FC;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.img-plus {
  font-size: 48rpx;
  color: #B3B8C8;
}

.img-tip {
  font-size: 22rpx;
  color: #B3B8C8;
  margin-top: 6rpx;
}

.notice {
  margin: 0 24rpx 24rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #FFF9EC;
  box-sizing: border-box;
}

.notice-t {
  font-size: 26rpx;
  font-weight: 600;
  color: #B37A2E;
  display: block;
  margin-bottom: 8rpx;
}

.notice-d {
  display: block;
  font-size: 22rpx;
  color: #C29A63;
  margin-top: 6rpx;
}

.submit {
  margin: 0 48rpx 40rpx;
}

/* 提交锁生效时的禁用态 */
.btn-off {
  opacity: 0.55;
}

/* ---- AI 辅助填写 ---- */
.ai-card {
  margin: 0 24rpx 24rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
}

.ai-head { margin-bottom: 16rpx; }

.ai-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1B1F2B;
}

.ai-sub {
  display: block;
  font-size: 22rpx;
  color: #8A8FA3;
  margin-top: 6rpx;
}

.ai-btn {
  height: 76rpx;
  border-radius: 38rpx;
  background: #EEF2FF;
  color: #3A6BFF;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ai-btn-off { background: #F0F1F5; color: #8A8FA3; }

.ai-item {
  display: flex;
  align-items: flex-start;
  padding: 10rpx 0;
  border-bottom: 1rpx solid #F2F3F7;
}

.ai-k {
  width: 90rpx;
  font-size: 24rpx;
  color: #8A8FA3;
  flex-shrink: 0;
}

.ai-v {
  flex: 1;
  font-size: 26rpx;
  color: #1B1F2B;
  line-height: 1.5;
}

.ai-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.ai-act {
  flex: 1;
  height: 72rpx;
  border-radius: 36rpx;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ai-act.primary { background: #3A6BFF; color: #fff; }
.ai-act.ghost { background: #F0F1F5; color: #5B6072; }

.ai-hint {
  display: block;
  font-size: 22rpx;
  color: #8A8FA3;
  margin-top: 14rpx;
}
