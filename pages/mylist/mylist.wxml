<view class="page">
  <view wx:if="{{items.length > 0}}">
    <item-card
      wx:for="{{items}}"
      wx:key="id"
      item="{{item}}"
      best="{{item._best}}"
      bind:tap="goDetail"
    />
  </view>

  <view wx:elif="{{clues.length > 0}}">
    <view class="card clue" wx:for="{{clues}}" wx:key="id" data-id="{{item.itemId}}" bindtap="goDetail">
      <view class="row-between">
        <text class="clue-from">来自：{{item.itemTitle}}</text>
        <text wx:if="{{item.score > 0}}" class="clue-score">相关度 {{item.score}}%</text>
      </view>
      <text class="clue-content">{{item.content}}</text>
      <view class="row-between">
        <text class="sub">{{item.author}} · {{item.timeText}}</text>
        <text wx:if="{{item.contact}}" class="sub">联系：{{item.contact}}</text>
      </view>
    </view>
  </view>

  <view wx:else class="empty">
    <text class="empty-icon">📭</text>
    <text class="empty-text">这里还没有内容</text>
    <view class="empty-btn" bindtap="goPublish"><text>去发布一条</text></view>
  </view>
</view>
