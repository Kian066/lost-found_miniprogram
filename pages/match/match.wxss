.hero {
  margin: 24rpx;
  padding: 32rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #3A6BFF 0%, #6E8CFF 100%);
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.hero-t {
  font-size: 34rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.hero-d {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.88);
  margin-top: 10rpx;
}

.bases {
  margin-top: 16rpx;
  white-space: nowrap;
}

.bases-inner {
  display: flex;
  flex-direction: row;
}

.base {
  width: 260rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #F7F8FC;
  margin-right: 16rpx;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  border: 2rpx solid transparent;
}

.base-on {
  background: #F0F4FF;
  border: 2rpx solid #3A6BFF;
}

.base-emoji {
  font-size: 44rpx;
}

.base-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1A1D26;
  margin-top: 8rpx;
}

.base-foot {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: 10rpx;
}

.base-type {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
}

.t-lost {
  background: #FFF1EC;
  color: #FF6B4A;
}

.t-found {
  background: #E8F9F1;
  color: #12B981;
}

.no-base {
  margin-top: 12rpx;
}

.go-pub {
  margin-top: 20rpx;
}

.search {
  display: flex;
  flex-direction: row;
  align-items: center;
  background: #F7F8FC;
  border-radius: 16rpx;
  height: 84rpx;
  padding: 0 24rpx;
  margin-top: 16rpx;
  box-sizing: border-box;
}

.s-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.s-input {
  flex: 1;
  height: 84rpx;
  font-size: 26rpx;
}

.ph {
  color: #B3B8C8;
  font-size: 26rpx;
}

.cat-row {
  margin-top: 20rpx;
}

.mini-picker {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #EAF0FF;
  color: #3A6BFF;
  font-size: 24rpx;
}

.submit {
  margin-top: 28rpx;
}

.res-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 32rpx 12rpx;
}

.res-t {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1D26;
}

.res-top {
  font-size: 24rpx;
  color: #FF6B4A;
}

.res {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin: 0 24rpx 16rpx;
  box-sizing: border-box;
}

.res-l {
  flex: 1;
  display: flex;
  flex-direction: row;
  align-items: center;
}

.res-emoji {
  font-size: 48rpx;
  margin-right: 16rpx;
}

.res-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.res-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1D26;
}

.res-r {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.res-score {
  font-size: 34rpx;
  font-weight: 700;
  color: #FF9F43;
}

.s-high {
  color: #FF4D4F;
}

.res-dir {
  font-size: 20rpx;
  color: #8A8FA3;
  margin-top: 4rpx;
}

.bar {
  height: 12rpx;
  background: #F0F2F7;
  border-radius: 999rpx;
  margin: 14rpx 0;
  overflow: hidden;
}

.bar-in {
  height: 12rpx;
  border-radius: 999rpx;
  background: #FF9F43;
}

.bar-in.high {
  background: linear-gradient(90deg, #FF6B4A, #FF4D4F);
}

.bar-in.mid {
  background: linear-gradient(90deg, #FFC46B, #FF9F43);
}

.bar-in.low {
  background: #C9CFDD;
}

.m-reasons {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.m-reason {
  font-size: 20rpx;
  color: #6B7185;
  background: #F7F8FC;
  border-radius: 8rpx;
  padding: 6rpx 14rpx;
  margin: 0 12rpx 12rpx 0;
}

.res-foot {
  margin-top: 4rpx;
}

.mini {
  width: 260rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 26rpx;
}
