<view class="page">
  <!-- 用户卡 -->
  <view class="profile">
    <button
      wx:if="{{editing}}"
      class="avatar-btn"
      open-type="chooseAvatar"
      bindchooseavatar="onChooseAvatar"
    >
      <image wx:if="{{form.avatar}}" class="avatar-img" src="{{form.avatar}}" mode="aspectFill" />
      <text wx:else class="avatar-t">{{initial}}</text>
    </button>
    <view wx:else class="avatar">
      <image wx:if="{{user.avatar}}" class="avatar-img" src="{{user.avatar}}" mode="aspectFill" />
      <text wx:else class="avatar-t">{{initial}}</text>
    </view>
    <view class="p-info">
      <text class="p-name">{{user.name}}</text>
      <text class="p-sub">{{user.college || '未填写学院'}} · 学号 {{user.sid || '未填写'}}</text>
    </view>
    <view class="credit">
      <text class="credit-n">{{user.credit}}</text>
      <text class="credit-l">信用分</text>
    </view>
  </view>

  <!-- 编辑资料 -->
  <view class="card form-card" wx:if="{{editing}}">
    <view class="form-tip">点击左侧头像可更换；昵称支持使用微信昵称</view>
    <view class="field">
      <text class="field-label">昵称</text>
      <input
        class="field-input"
        type="nickname"
        value="{{form.name}}"
        data-key="name"
        bindinput="onFormInput"
        placeholder="请填写昵称"
        maxlength="16"
      />
    </view>
    <view class="field">
      <text class="field-label">学号</text>
      <input
        class="field-input"
        value="{{form.sid}}"
        data-key="sid"
        bindinput="onFormInput"
        placeholder="选填，便于核实身份"
        maxlength="24"
      />
    </view>
    <view class="field">
      <text class="field-label">学院</text>
      <input
        class="field-input"
        value="{{form.college}}"
        data-key="college"
        bindinput="onFormInput"
        placeholder="选填，如 计算机学院"
        maxlength="24"
      />
    </view>
    <view class="field">
      <text class="field-label">联系方式</text>
      <input
        class="field-input"
        value="{{form.contact}}"
        data-key="contact"
        bindinput="onFormInput"
        placeholder="如微信号，发布时自动带入"
        maxlength="40"
      />
    </view>
    <view class="form-actions">
      <view class="btn-ghost" bindtap="toggleEdit">取消</view>
      <view class="btn-primary" bindtap="saveProfile">保存</view>
    </view>
  </view>

  <!-- 统计 -->
  <view class="stats">
    <view class="stat">
      <text class="stat-num">{{stats.publish}}</text>
      <text class="stat-label">我的发布</text>
    </view>
    <view class="stat">
      <text class="stat-num c-orange">{{stats.inbox}}</text>
      <text class="stat-label">收到线索</text>
    </view>
    <view class="stat">
      <text class="stat-num c-blue">{{stats.clue}}</text>
      <text class="stat-label">提供线索</text>
    </view>
    <view class="stat">
      <text class="stat-num c-green">{{stats.solved}}</text>
      <text class="stat-label">已找回</text>
    </view>
  </view>

  <!-- 菜单 -->
  <view class="card menu-card">
    <view
      class="menu"
      wx:for="{{menus}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="goMenu"
    >
      <text class="menu-icon">{{item.icon}}</text>
      <view class="menu-info">
        <text class="menu-name">{{item.name}}</text>
        <text class="menu-desc">{{item.desc}}</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>

    <!-- 仅管理员可见 -->
    <view class="menu" wx:if="{{isAdmin}}" data-key="admin" bindtap="goMenu">
      <text class="menu-icon">🛡️</text>
      <view class="menu-info">
        <text class="menu-name">管理后台</text>
        <text class="menu-desc">下架信息、处理举报</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 其他 -->
  <view class="card menu-card">
    <view class="menu" bindtap="about">
      <text class="menu-icon">ℹ️</text>
      <view class="menu-info">
        <text class="menu-name">关于平台</text>
        <text class="menu-desc">匹配规则与数据说明</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu" bindtap="resetData">
      <text class="menu-icon">♻️</text>
      <view class="menu-info">
        <text class="menu-name">恢复演示数据</text>
        <text class="menu-desc">清空本机数据并重置</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="foot-tip">
    <text class="sub">遇到问题可联系校园服务中心 · 失物招领处（图书馆一楼）</text>
  </view>
</view>
