.page {
  min-height: 100vh;
  background: #f5f6fa;
  padding: 24rpx 24rpx 60rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.card-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1b1f2b;
  margin-bottom: 20rpx;
}

.hero-row {
  display: flex;
  align-items: center;
}

.hero-emoji {
  font-size: 52rpx;
  margin-right: 20rpx;
}

.hero-main {
  display: flex;
  flex-direction: column;
}

.hero-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1b1f2b;
}

.hero-sub {
  font-size: 24rpx;
  color: #8a8fa3;
  margin-top: 6rpx;
}

.textarea {
  width: 100%;
  height: 200rpx;
  font-size: 28rpx;
  line-height: 1.6;
  background: #f5f6fa;
  border-radius: 14rpx;
  padding: 20rpx;
  box-sizing: border-box;
}

.input {
  width: 100%;
  height: 84rpx;
  font-size: 28rpx;
  background: #f5f6fa;
  border-radius: 14rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
}

.ph {
  color: #b3b8c8;
}

.hint {
  display: block;
  font-size: 22rpx;
  color: #8a8fa3;
  margin-top: 16rpx;
  line-height: 1.6;
}

.btn {
  height: 92rpx;
  border-radius: 46rpx;
  background: #3a6bff;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-disabled {
  background: #b9c6f5;
}
