<view class="page">
  <view class="tabs">
    <view class="tab {{mode === 'sent' ? 'tab-on' : ''}}" data-mode="sent" bindtap="switchMode">
      <text>我发出的</text>
    </view>
    <view class="tab {{mode === 'received' ? 'tab-on' : ''}}" data-mode="received" bindtap="switchMode">
      <text>我收到的</text>
    </view>
  </view>

  <view wx:if="{{list.length > 0}}">
    <view class="card" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
      <view class="row">
        <text class="title">{{item.itemTitle}}</text>
        <text class="badge {{item.tone}}">{{item.statusText}}</text>
      </view>
      <view class="row sub-row">
        <text class="sub">{{mode === 'received' ? '申请人：' + item.who : '我提交的申请'}}</text>
        <text class="sub">{{item.timeText}}</text>
      </view>
      <text wx:if="{{item.reason}}" class="reason">说明：{{item.reason}}</text>
    </view>
  </view>

  <view wx:elif="{{!loading}}" class="empty">
    <text class="empty-icon">📭</text>
    <text class="empty-text">{{mode === 'received' ? '还没有人申请认领你的招领' : '你还没有提交过认领申请'}}</text>
  </view>
</view>
