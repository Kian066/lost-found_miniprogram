.page {
  min-height: 100vh;
  background: #f5f6fa;
  padding: 24rpx 24rpx 60rpx;
  box-sizing: border-box;
}

.tabs {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.tab {
  flex: 1;
  height: 72rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #5b6072;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-on {
  background: #eef2ff;
  color: #3a6bff;
  font-weight: 600;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sub-row {
  margin-top: 14rpx;
}

.title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1b1f2b;
  flex: 1;
  margin-right: 16rpx;
}

.badge {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.badge.warn { background: #fff4e5; color: #e08a00; }
.badge.ok { background: #e8f8ef; color: #18a058; }
.badge.muted { background: #f0f1f5; color: #8a8fa3; }

.sub {
  font-size: 24rpx;
  color: #8a8fa3;
}

.reason {
  display: block;
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #e08a00;
}

.empty {
  padding-top: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-icon {
  font-size: 90rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 26rpx;
  color: #8a8fa3;
}
