.page {
  padding-bottom: 140rpx;
}

.head {
  padding: 40rpx 32rpx;
  box-sizing: border-box;
}

.head-lost {
  background: linear-gradient(135deg, #FF8A65 0%, #FF6B4A 100%);
}

.head-found {
  background: linear-gradient(135deg, #3ECF9A 0%, #12B981 100%);
}

.head-top {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.head-emoji {
  font-size: 72rpx;
  margin-right: 24rpx;
}

.head-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.head-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.head-tags {
  display: flex;
  flex-direction: row;
  margin-top: 12rpx;
}

.head-tags .tag {
  margin-right: 12rpx;
  background: rgba(255, 255, 255, 0.25);
  color: #FFFFFF;
}

.kv {
  display: flex;
  flex-direction: row;
  margin-bottom: 16rpx;
}

.kv:last-child {
  margin-bottom: 0;
}

.k {
  width: 140rpx;
  font-size: 26rpx;
  color: #8A8FA3;
}

.v {
  flex: 1;
  font-size: 26rpx;
  color: #1A1D26;
}

.v-contact {
  color: #3A6BFF;
  font-weight: 600;
}

.v-tip {
  display: block;
  font-size: 22rpx;
  color: #B37A2E;
  background: #FFF9EC;
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
  margin-top: 12rpx;
}

.desc {
  font-size: 28rpx;
  color: #3A3F4D;
  margin-top: 12rpx;
}

.chips {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.chip {
  font-size: 22rpx;
  color: #3A6BFF;
  background: #EAF0FF;
  border-radius: 8rpx;
  padding: 6rpx 16rpx;
  margin: 0 12rpx 12rpx 0;
}

.imgs {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  margin: 0 16rpx 16rpx 0;
}

.match-wrap {
  margin: 0 24rpx 20rpx;
}

.m-head {
  margin-bottom: 16rpx;
}

.match-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-sizing: border-box;
}

.m-title {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1D26;
  margin-right: 16rpx;
}

.m-score {
  font-size: 32rpx;
  font-weight: 700;
  color: #FF9F43;
}

.s-high {
  color: #FF4D4F;
}

.bar {
  height: 12rpx;
  background: #F0F2F7;
  border-radius: 999rpx;
  margin: 14rpx 0;
  overflow: hidden;
}

.bar-in {
  height: 12rpx;
  border-radius: 999rpx;
  background: #FF9F43;
}

.bar-in.high {
  background: linear-gradient(90deg, #FF6B4A, #FF4D4F);
}

.bar-in.mid {
  background: linear-gradient(90deg, #FFC46B, #FF9F43);
}

.bar-in.low {
  background: #C9CFDD;
}

.m-reasons {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.m-reason {
  font-size: 20rpx;
  color: #6B7185;
  background: #F7F8FC;
  border-radius: 8rpx;
  padding: 6rpx 14rpx;
  margin: 0 12rpx 12rpx 0;
}

.m-foot {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.m-go {
  font-size: 24rpx;
  color: #3A6BFF;
}

.no-match {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 32rpx;
  box-sizing: border-box;
}

.clue {
  border-top: 2rpx solid #F0F2F7;
  padding: 20rpx 0;
}

.clue:first-of-type {
  border-top: none;
}

.clue-author {
  font-size: 26rpx;
  font-weight: 600;
  color: #1A1D26;
}

.clue-score {
  font-size: 22rpx;
  color: #FF9F43;
}

.clue-content {
  font-size: 26rpx;
  color: #3A3F4D;
  margin: 10rpx 0;
  display: block;
}

.clue-input {
  width: 100%;
  height: 180rpx;
  background: #F7F8FC;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  margin-top: 16rpx;
  box-sizing: border-box;
}

.ph {
  color: #B3B8C8;
  font-size: 26rpx;
}

.input {
  height: 84rpx;
  background: #F7F8FC;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.mt {
  margin-top: 16rpx;
}

.submit {
  margin-top: 24rpx;
}

.footbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 112rpx;
  background: #FFFFFF;
  border-top: 2rpx solid #F0F2F7;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.fb-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 32rpx;
}

.fb-icon {
  font-size: 32rpx;
}

.fb-text {
  font-size: 20rpx;
  color: #8A8FA3;
  margin-top: 2rpx;
}

.fb-main {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 40rpx;
  background: #3A6BFF;
  color: #FFFFFF;
  font-size: 28rpx;
}
