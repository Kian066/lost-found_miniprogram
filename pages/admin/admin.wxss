.page {
  min-height: 100vh;
  background: #f5f6fa;
  padding: 24rpx 24rpx 60rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.card-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1b1f2b;
  margin-bottom: 20rpx;
}

.hint {
  display: block;
  font-size: 24rpx;
  color: #8a8fa3;
  line-height: 1.7;
  margin-bottom: 24rpx;
}

.tabs {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 20rpx;
}

.tab {
  flex: 1;
  height: 72rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #5b6072;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-on {
  background: #eef2ff;
  color: #3a6bff;
  font-weight: 600;
}

.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx 16rpx;
}

.count { font-size: 24rpx; color: #8a8fa3; }

.filter {
  font-size: 24rpx;
  color: #3a6bff;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  background: #eef2ff;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sub-row { margin-top: 12rpx; }

.title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1b1f2b;
  flex: 1;
  margin-right: 16rpx;
}

.badge {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.badge.ok { background: #e8f8ef; color: #18a058; }
.badge.warn { background: #fff4e5; color: #e08a00; }
.badge.muted { background: #f0f1f5; color: #8a8fa3; }

.sub { font-size: 24rpx; color: #8a8fa3; }
.muted-text { color: #e08a00; }

.reason {
  display: block;
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #3c4155;
  line-height: 1.6;
}

.btn-row {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.btn {
  flex: 1;
  height: 76rpx;
  border-radius: 38rpx;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 8rpx;
}

.btn.primary { background: #3a6bff; color: #fff; }
.btn.ghost { background: #f0f1f5; color: #5b6072; }
.btn-disabled { background: #b9c6f5; color: #fff; }

.empty {
  padding-top: 140rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-icon { font-size: 90rpx; margin-bottom: 20rpx; }
.empty-text { font-size: 26rpx; color: #8a8fa3; }
